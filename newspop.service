[Unit]
Description=NewsPop news aggregator
After=network.target

[Service]
Type=simple
User=newspop
WorkingDirectory=/opt/newspop
Environment=HOST=0.0.0.0
Environment=PORT=3000
Environment=CLUSTER_MODE=tfidf
ExecStart=/usr/bin/node app.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
